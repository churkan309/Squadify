rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		function signedIn() {
			return request.auth != null;
		}

		function isUser(uid) {
			return signedIn() && request.auth.uid == uid;
		}

		function userPath(uid) {
			return /databases/$(database)/documents/users/$(uid);
		}

		function partyPath(partyId) {
			return /databases/$(database)/documents/parties/$(partyId);
		}

		function memberPath(partyId, uid) {
			return /databases/$(database)/documents/parties/$(partyId)/members/$(uid);
		}

		function postPath(postId) {
			return /databases/$(database)/documents/posts/$(postId);
		}

		function isPartyMember(partyId) {
			return signedIn() && exists(memberPath(partyId, request.auth.uid));
		}

		function isPartyHost(partyId) {
			return signedIn()
				&& get(partyPath(partyId)).data.hostId == request.auth.uid;
		}

		function validText(value, maximum) {
			return value is string && value.size() > 0 && value.size() <= maximum;
		}

		function validUserProfile(data) {
			return data.keys().hasOnly([
					'uid', 'username', 'email', 'avatarUrl', 'createdAt'
				])
				&& data.uid is string
				&& validText(data.username, 50)
				&& validText(data.email, 200)
				&& data.avatarUrl is string
				&& data.createdAt == request.time;
		}

		function validParty(data) {
			return data.keys().hasOnly([
					'game', 'iconPath', 'maxMembers', 'description', 'hostId',
					'hostName', 'memberCount', 'status', 'createdAt'
				])
				&& validText(data.game, 80)
				&& validText(data.iconPath, 200)
				&& data.maxMembers is int
				&& data.maxMembers > 0
				&& data.description is string
				&& data.description.size() <= 500
				&& validText(data.hostId, 128)
				&& validText(data.hostName, 50)
				&& data.memberCount is int
				&& data.memberCount > 0
				&& data.memberCount <= data.maxMembers
				&& data.status == 'open'
				&& data.createdAt == request.time;
		}

		function validMember(data, uid) {
			return data.keys().hasOnly([
					'uid', 'name', 'avatarUrl', 'isLeader', 'joinedAt'
				])
				&& data.uid == uid
				&& validText(data.name, 50)
				&& data.avatarUrl is string
				&& data.isLeader is bool
				&& data.joinedAt == request.time;
		}

		function validPost(data) {
			return data.keys().hasOnly([
					'partyId', 'authorId', 'authorName', 'content', 'commentCount',
					'createdAt'
				])
				&& validText(data.partyId, 128)
				&& data.authorId == request.auth.uid
				&& data.authorName == get(userPath(request.auth.uid)).data.username
				&& validText(data.content, 2000)
				&& data.commentCount == 0
				&& data.createdAt == request.time;
		}

		function validComment(data) {
			return data.keys().hasOnly([
					'authorId', 'authorName', 'content', 'createdAt'
				])
				&& data.authorId == request.auth.uid
				&& data.authorName == get(userPath(request.auth.uid)).data.username
				&& validText(data.content, 2000)
				&& data.createdAt == request.time;
		}

		function validMemberCreate(partyId, memberId) {
			return signedIn()
				&& memberId == request.auth.uid
				&& validMember(request.resource.data, memberId)
				&& (
					(
						getAfter(partyPath(partyId)).data.hostId == request.auth.uid
						&& getAfter(partyPath(partyId)).data.memberCount == 1
						&& request.resource.data.isLeader == true
					)
					||
					(
						get(partyPath(partyId)).data.status == 'open'
						&& get(partyPath(partyId)).data.memberCount
								< get(partyPath(partyId)).data.maxMembers
						&& getAfter(partyPath(partyId)).data.memberCount
								== get(partyPath(partyId)).data.memberCount + 1
						&& request.resource.data.isLeader == false
					)
				);
		}

		function validJoinUpdate(partyId) {
			return signedIn()
				&& resource.data.status == 'open'
				&& resource.data.memberCount < resource.data.maxMembers
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'memberCount', 'status'
				])
				&& request.resource.data.memberCount == resource.data.memberCount + 1
				&& (
					(
						request.resource.data.memberCount >= request.resource.data.maxMembers
						&& request.resource.data.status == 'full'
					)
					||
					(
						request.resource.data.memberCount < request.resource.data.maxMembers
						&& request.resource.data.status == 'open'
					)
				)
				&& !exists(memberPath(partyId, request.auth.uid))
				&& getAfter(memberPath(partyId, request.auth.uid)).data.uid
						== request.auth.uid;
		}

		function validLeaveUpdate(partyId) {
			return signedIn()
				&& resource.data.hostId != request.auth.uid
				&& resource.data.memberCount > 0
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'memberCount', 'status'
				])
				&& request.resource.data.memberCount == resource.data.memberCount - 1
				&& request.resource.data.status == 'open'
				&& exists(memberPath(partyId, request.auth.uid))
				&& !existsAfter(memberPath(partyId, request.auth.uid));
		}

		function validRemoveMemberUpdate(partyId) {
			return isPartyHost(partyId)
				&& resource.data.memberCount > 1
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'memberCount', 'status'
				])
				&& request.resource.data.memberCount == resource.data.memberCount - 1
				&& request.resource.data.status == 'open';
		}

		match /users/{uid} {
			allow read: if isUser(uid);

			allow create: if isUser(uid)
				&& request.resource.data.uid == uid
				&& validUserProfile(request.resource.data);

			allow update: if isUser(uid)
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'username', 'avatarUrl'
				])
				&& request.resource.data.uid == resource.data.uid
				&& request.resource.data.email == resource.data.email
				&& request.resource.data.createdAt == resource.data.createdAt
				&& validText(request.resource.data.username, 50)
				&& request.resource.data.avatarUrl is string;

			allow delete: if false;
		}

		match /parties/{partyId} {
			allow read: if signedIn();

			allow create: if signedIn()
				&& validParty(request.resource.data)
				&& request.resource.data.hostId == request.auth.uid
				&& request.resource.data.hostName
						== get(userPath(request.auth.uid)).data.username
				&& getAfter(memberPath(partyId, request.auth.uid)).data.uid
						== request.auth.uid
				&& getAfter(memberPath(partyId, request.auth.uid)).data.isLeader == true;

			allow update: if (
					isPartyHost(partyId)
					&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
						'description'
					])
					&& request.resource.data.description is string
					&& request.resource.data.description.size() <= 500
				)
				|| validJoinUpdate(partyId)
				|| validLeaveUpdate(partyId)
				|| validRemoveMemberUpdate(partyId);

			allow delete: if isPartyHost(partyId);
		}

		match /parties/{partyId}/members/{memberId} {
			allow read: if signedIn();

			allow create: if validMemberCreate(partyId, memberId);

			allow update: if signedIn()
				&& (
					(
						isPartyHost(partyId)
						&& memberId != request.auth.uid
						&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
							'name', 'avatarUrl'
						])
					)
					||
					(
						memberId == request.auth.uid
						&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
							'name', 'avatarUrl'
						])
						&& request.resource.data.uid == resource.data.uid
						&& request.resource.data.isLeader == resource.data.isLeader
						&& request.resource.data.joinedAt == resource.data.joinedAt
					)
				);

			allow delete: if signedIn()
				&& (
					(
						isPartyHost(partyId)
						&& memberId != request.auth.uid
					)
					||
					(
						memberId == request.auth.uid
						&& get(partyPath(partyId)).data.hostId != request.auth.uid
						&& getAfter(partyPath(partyId)).data.memberCount
								== get(partyPath(partyId)).data.memberCount - 1
					)
				);
		}

		match /posts/{postId} {
			allow read: if signedIn()
				&& isPartyMember(resource.data.partyId);

			allow create: if signedIn()
				&& validPost(request.resource.data)
				&& isPartyMember(request.resource.data.partyId);

			allow update: if signedIn()
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'commentCount'
				])
				&& request.resource.data.commentCount == resource.data.commentCount + 1
				&& isPartyMember(resource.data.partyId);

			allow delete: if false;

			match /comments/{commentId} {
				allow read: if signedIn()
					&& isPartyMember(get(postPath(postId)).data.partyId);

				allow create: if signedIn()
					&& validComment(request.resource.data)
					&& isPartyMember(get(postPath(postId)).data.partyId)
					&& getAfter(postPath(postId)).data.commentCount
							== get(postPath(postId)).data.commentCount + 1;

				allow update, delete: if false;
			}
		}

		match /{document=**} {
			allow read, write: if false;
		}
	}
}
